IDLECLOUD_PUBLIC_ORIGIN=https://idlecloud.example.com
IDLECLOUD_STUDIO_WEB_ORIGIN=https://studio.example.com
IDLECLOUD_STUDIO_API_BASE=http://127.0.0.1:8000
IDLECLOUD_PORT=46011
IDLECLOUD_DATA_DIR=/var/lib/idlecloud
# 首发保留原默认值；并发验收后再调整，不启用多进程。
IDLECLOUD_THREADS=8
IDLECLOUD_CONNECTION_LIMIT=100
IDLECLOUD_CHANNEL_TIMEOUT=120
